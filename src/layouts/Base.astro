---
import '@fontsource-variable/inter';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { Lang } from '../data/teksten';

interface Props { title: string; description?: string; lang?: Lang; land?: string; noindex?: boolean; }
const { title, description = 'An independent guide to fitness passes and gyms with flexible memberships, country by country.', lang = 'en', land = 'global', noindex = false } = Astro.props;
const fullTitle = title.includes('FlexGymGuide') ? title : `${title} | FlexGymGuide`;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Cloudflare Web Analytics: cookieloze bezoekersteller. Leeg = uit.
const cfToken = '';
---
<!doctype html>
<html lang={lang === 'en' ? 'en' : lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Awin: bewijs dat de site van ons is -->
    <meta name="verification" content="d74d5d3dbbd2a861aa238f2b4bc1f80c" />
    <!-- Impact (ClassPass): bewijs dat de site van ons is -->
    <meta name="impact-site-verification" value="37a69ce6-78ce-4698-9b62-2595c2e52b44" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="FlexGymGuide" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og-image.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    {cfToken && <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: cfToken })}></script>}
  </head>
  <body>
    <Header land={land} lang={lang} />
    <main><slot /></main>
    <Footer lang={lang} />
  </body>
</html>
