---
import { teksten, type Lang } from '../data/teksten';
import menu from '../data/menu.json';
const { lang = 'en' } = Astro.props as { lang?: Lang };
const t = teksten[lang];
const landenKop = { nl: 'Landen', de: 'Länder', en: 'Countries', fr: 'Pays', es: 'Países', pt: 'Países', da: 'Lande', sv: 'Länder', nb: 'Land', fi: 'Maat' }[lang];
const year = new Date().getFullYear();
---
<footer>
  <div class="wrap cols">
    <div>
      <strong>FlexGymGuide</strong>
      <p>{t.over}</p>
    </div>
    <div>
      <p>{t.melding} <a href={t.meldingHref}>{t.meldingLink}</a></p>
    </div>
  </div>
  <nav class="wrap landen" id="landen" aria-label={landenKop}>
    <strong>{landenKop}</strong>
    <ul>{menu.main.map((m) => <li><a href={m.href}>{m.label}</a></li>)}</ul>
  </nav>
  <nav class="balk" aria-label="Footer">
    <div class="wrap balk-in">
      <ul>{t.footer.map((m) => <li><a href={m.href}>{m.label}</a></li>)}</ul>
      <span>© {year} flexgymguide.com</span>
    </div>
  </nav>
</footer>
<style>
  footer { margin-top: 3rem; background: var(--accent); padding-top: 1.5rem; color: rgba(255,255,255,.75); font-size: .85rem; line-height: 1.5; }
  footer a { color: #fff; }
  .cols { display: grid; gap: .5rem 2rem; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }
  strong { color: #fff; font-size: 1rem; font-weight: 600; }
  .cols p { margin: .25rem 0 0; }
  .landen { margin-top: 1rem; }
  .landen ul { list-style: none; margin: .35rem 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: .35rem 1.25rem; }
  .landen a { text-decoration: none; }
  .landen a:hover { text-decoration: underline; }
  .balk { margin-top: 1rem; border-top: 1px solid rgba(255,255,255,.15); padding: .75rem 0; }
  .balk-in { display: flex; flex-wrap: wrap; gap: .75rem 2rem; align-items: center; justify-content: space-between; }
  .balk ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: .5rem 1.5rem; }
  .balk a { color: #fff; font-weight: 500; text-decoration: none; }
  .balk a:hover { text-decoration: underline; }
  .balk span { font-size: .82rem; }
</style>
