---
import { getCollection } from 'astro:content';
import menu from '../data/menu.json';
const { land = 'global', lang = 'en' } = Astro.props;
type L = 'nl' | 'de' | 'en' | 'fr' | 'es' | 'pt' | 'da' | 'sv' | 'nb' | 'fi';
// Geen landenlijst in de kop: bezoekers komen op hun eigen land binnen. "Andere landen" springt naar de landenlijst in de footer (de homepage zou de browser doorsturen naar het eigen land).
const landenLabel = { nl: 'Andere landen', de: 'Andere Länder', en: 'Other countries', fr: 'Autres pays', es: 'Otros países', pt: 'Outros países', da: 'Andre lande', sv: 'Andra länder', nb: 'Andre land', fi: 'Muut maat' }[lang as L];
// Zoekfunctie (Pagefind): teksten per taal. DK/SE/NO in du-vorm, Fins in sinä-vorm.
const zoek = {
  nl: { knop: 'Zoeken', veld: 'Zoek een stad of sportschool', geen: 'Niets gevonden. Probeer een andere stad of naam.', sluit: 'Sluiten' },
  de: { knop: 'Suchen', veld: 'Stadt oder Fitnessstudio suchen', geen: 'Nichts gefunden. Versuch es mit einer anderen Stadt oder einem anderen Namen.', sluit: 'Schließen' },
  en: { knop: 'Search', veld: 'Search for a city or gym', geen: 'Nothing found. Try another city or name.', sluit: 'Close' },
  fr: { knop: 'Rechercher', veld: 'Chercher une ville ou une salle', geen: 'Aucun résultat. Essayez une autre ville ou un autre nom.', sluit: 'Fermer' },
  es: { knop: 'Buscar', veld: 'Busca una ciudad o un gimnasio', geen: 'No hay resultados. Prueba con otra ciudad u otro nombre.', sluit: 'Cerrar' },
  pt: { knop: 'Pesquisar', veld: 'Pesquise uma cidade ou ginásio', geen: 'Nada encontrado. Experimente outra cidade ou outro nome.', sluit: 'Fechar' },
  da: { knop: 'Søg', veld: 'Søg efter en by eller et fitnesscenter', geen: 'Intet fundet. Prøv en anden by eller et andet navn.', sluit: 'Luk' },
  sv: { knop: 'Sök', veld: 'Sök efter en stad eller ett gym', geen: 'Inget hittades. Testa en annan stad eller ett annat namn.', sluit: 'Stäng' },
  nb: { knop: 'Søk', veld: 'Søk etter en by eller et treningssenter', geen: 'Ingen treff. Prøv en annen by eller et annet navn.', sluit: 'Lukk' },
  fi: { knop: 'Haku', veld: 'Hae kaupunkia tai kuntosalia', geen: 'Ei tuloksia. Kokeile toista kaupunkia tai nimeä.', sluit: 'Sulje' },
}[lang as L];
// Melding als een plaats (nog) niet op de site staat, met verwijzing naar de landpagina en de ClassPass-pagina van het land.
const onbekend = {
  nl: { zin: 'We hebben nog geen pagina over {p}.', verder: 'Kijk verder bij:', wel: 'Wel gevonden:' },
  de: { zin: 'Zu {p} haben wir noch keine Seite.', verder: 'Schau hier weiter:', wel: 'Das haben wir gefunden:' },
  en: { zin: "We don't have a page about {p} yet.", verder: 'Try these instead:', wel: 'What we did find:' },
  fr: { zin: "Nous n'avons pas encore de page sur {p}.", verder: 'Voir plutôt :', wel: 'Ce que nous avons trouvé :' },
  es: { zin: 'Todavía no tenemos una página sobre {p}.', verder: 'Mira aquí:', wel: 'Esto sí lo hemos encontrado:' },
  pt: { zin: 'Ainda não temos uma página sobre {p}.', verder: 'Veja aqui:', wel: 'Isto encontrámos:' },
  da: { zin: 'Vi har endnu ingen side om {p}.', verder: 'Kig her i stedet:', wel: 'Det fandt vi:' },
  sv: { zin: 'Vi har ingen sida om {p} än.', verder: 'Titta här i stället:', wel: 'Det här hittade vi:' },
  nb: { zin: 'Vi har ingen side om {p} ennå.', verder: 'Se her i stedet:', wel: 'Dette fant vi:' },
  fi: { zin: 'Meillä ei ole vielä sivua haulle {p}.', verder: 'Katso sen sijaan:', wel: 'Löysimme nämä:' },
}[lang as L];
// Landnamen voor het labeltje bij elk zoekresultaat.
const landNamen = Object.fromEntries(menu.main.map((m) => [m.land, m.label]));
const huidig = menu.main.find((m) => m.land === land);
// Korte landnaam op smalle schermen, zodat de kop op één regel past.
const kort = ({ 'United Kingdom': 'UK' } as Record<string, string>)[huidig?.label ?? ''];
// Verwijzingen in de melding: eigen land + ClassPass in dat land; op de homepage en gidsen de landenlijst + de ClassPass-gids.
const paden = new Set((await getCollection('pages', (p) => !p.data.draft && !p.data.noindex)).map((p) => p.data.path));
const verwijzingen = huidig && land !== 'guides'
  ? [{ label: huidig.label, href: huidig.href }, ...(paden.has(`/${land}/classpass/`) ? [{ label: 'ClassPass', href: `/${land}/classpass/` }] : [])]
  : [{ label: landenLabel, href: '#landen' }, { label: 'ClassPass', href: '/guides/how-classpass-works/' }];
---
<header>
  <div class="wrap bar">
    <a class="logo" href="/"><svg class="logo-icoon" xmlns="http://www.w3.org/2000/svg" viewBox="2 6 44 44" aria-hidden="true"><rect x="2" y="6" width="44" height="44" rx="11" fill="currentColor"/><g transform="rotate(-30 24 28)" fill="#fff"><rect x="9" y="21" width="4" height="14" rx="1.5"/><rect x="13.5" y="23" width="4" height="10" rx="1.5"/><rect x="17" y="26.5" width="14" height="3" rx="1.5"/><rect x="30.5" y="23" width="4" height="10" rx="1.5"/><rect x="35" y="21" width="4" height="14" rx="1.5"/></g></svg><span class="logo-tekst">Flex<span>Gym</span>Guide</span></a>
    <nav aria-label="Main">
      <ul>
        {huidig && <li><a href={huidig.href} aria-current="true">{kort ? <><span class="land-lang">{huidig.label}</span><span class="land-kort" aria-hidden="true">{kort}</span></> : huidig.label}</a></li>}
        <li><a class="landen" href="#landen" aria-label={landenLabel} title={landenLabel}><svg class="landen-icoon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.7 3.6 5.7 3.6 9s-1.1 6.3-3.6 9c-2.5-2.7-3.6-5.7-3.6-9S9.5 5.7 12 3z"/></svg><span class="landen-tekst">{landenLabel}</span></a></li>
        <li><button type="button" class="zoek-knop" aria-label={zoek.knop} aria-expanded="false" aria-controls="zoeken" title={zoek.knop}><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m15.5 15.5 5 5"/></svg></button></li>
      </ul>
    </nav>
  </div>
  <div id="zoeken" class="zoek" hidden data-land={land} data-landen={JSON.stringify(landNamen)} data-geen={zoek.geen} data-onbekend={JSON.stringify({ ...onbekend, links: verwijzingen })}>
    <div class="wrap">
      <form class="zoek-form" role="search" action="#" onsubmit="return false">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m15.5 15.5 5 5"/></svg>
        <input type="search" placeholder={zoek.veld} aria-label={zoek.veld} autocomplete="off" spellcheck="false" />
        <button type="button" class="zoek-sluit" aria-label={zoek.sluit} title={zoek.sluit}><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg></button>
      </form>
      <ul class="zoek-resultaten" aria-live="polite"></ul>
    </div>
  </div>
</header>
<script>
  // Pagefind maakt bij de build één zoekindex van alle pagina's (map /pagefind/). Die wordt pas geladen als iemand op het vergrootglas klikt.
  const knop = document.querySelector<HTMLButtonElement>('.zoek-knop')!;
  const paneel = document.getElementById('zoeken')!;
  const veld = paneel.querySelector('input')!;
  const lijst = paneel.querySelector<HTMLUListElement>('.zoek-resultaten')!;
  const land = paneel.dataset.land!;
  const landen: Record<string, string> = JSON.parse(paneel.dataset.landen!);
  const taal = document.documentElement.lang;
  let pagefind: any;
  let teller = 0;

  const open = async (aan: boolean) => {
    paneel.hidden = !aan;
    knop.setAttribute('aria-expanded', String(aan));
    if (!aan) return knop.focus();
    veld.focus();
    if (!pagefind) {
      const pad = '/pagefind/pagefind.js';
      pagefind = await import(/* @vite-ignore */ pad).catch(() => null);
      await pagefind?.options({ excerptLength: 18 });
      pagefind?.init();
    }
  };
  knop.addEventListener('click', () => open(paneel.hidden));
  paneel.querySelector('.zoek-sluit')!.addEventListener('click', () => open(false));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !paneel.hidden) open(false); });
  document.addEventListener('click', (e) => { if (!paneel.hidden && !(e.target as Element).closest('header')) open(false); });

  // Zoekterm opschonen: schrijfwijzen gelijktrekken ("class pass" = classpass) en vraagwoorden weglaten,
  // want Pagefind zoekt pagina's waar álle woorden in staan ("hoe duur is classpass" -> "duur classpass").
  const stopwoorden = new Set('hoe wat is een de het van in op voor met bij waar welke kan ik je wie wat mijn how what is a an the of in on for with at where which can i my do does much many are wie was ist ein eine der die das den von im mit für bei wo welche kann ich mein comment quel quelle est un une le la les de du des pour avec où cómo qué es un una el la los las de del para con dónde como que é um uma o os da do das dos para com onde hvordan hvad hur vad hva er är ett en et og och miten mikä on'.split(' '));
  const schoon = (t: string) => {
    const woorden = t.toLowerCase()
      .replace(/class[\s-]+pass/g, 'classpass').replace(/basic[\s-]+fit/g, 'basic-fit').replace(/fitness[\s-]*first/g, 'fitness first')
      .replace(/[?!.,:;]/g, ' ').split(/\s+/).filter(Boolean);
    const zonder = woorden.filter((w) => !stopwoorden.has(w));
    return (zonder.length ? zonder : woorden).join(' ');
  };
  const esc = (t: string) => t.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  // Pagefind valt bij een onbekend woord terug op het langste begin dat wél bestaat ("alkmaar" -> "al", "als").
  // Daarom tellen we een woord alleen als gevonden als de eerste 4 letters echt aan het begin van een woord op de pagina staan.
  const plat = (t: string) => t.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
  const bevat = (d: any, w: string) => {
    const stam = plat(w).slice(0, 4).replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    return new RegExp(`(^|[^\\p{L}\\p{N}])${stam}`, 'u').test(plat(`${d.meta.title ?? ''} ${d.content ?? ''}`));
  };
  const melding = JSON.parse(paneel.dataset.onbekend!);
  const resultaat = (d: any) => {
    const li = document.createElement('li');
    const a = li.appendChild(document.createElement('a'));
    a.href = d.url;
    a.innerHTML = `<span class="titel">${esc(d.meta.title ?? '')}</span>${landen[d.meta.land] ? `<span class="land">${esc(landen[d.meta.land])}</span>` : ''}<span class="uittreksel">${d.meta.beschrijving ? esc(d.meta.beschrijving) : d.excerpt}</span>`;
    return li;
  };
  const zoekPagina = async (q: string, nr: number) => {
    const zoek = await pagefind.debouncedSearch(q, {}, 200);
    if (!zoek || nr !== teller) return null;
    const data = await Promise.all(zoek.results.slice(0, 40).map((r: any) => r.data()));
    return nr === teller ? data : null;
  };
  const sorteer = (data: any[], q: string) => {
    // Eerst het eigen land, dan pagina's in dezelfde taal, dan de rest. Binnen elke groep gaan pagina's met meer
    // zoekwoorden in de titel voor (eerste 4 letters tellen, zodat "prijzen" ook "prijs" vindt); daarna de volgorde van Pagefind.
    const groep = (d: any) => (d.meta.land === land ? 0 : d.meta.taal === taal ? 1 : 2);
    const stammen = q.split(' ').map((w) => w.slice(0, 4));
    const inTitel = (d: any) => { const t = String(d.meta.title ?? '').toLowerCase(); return stammen.filter((s) => t.includes(s)).length; };
    return data.map((d, i) => ({ d, i, t: inTitel(d) })).sort((a, b) => groep(a.d) - groep(b.d) || b.t - a.t || a.i - b.i).slice(0, 8).map(({ d }) => d);
  };
  veld.addEventListener('input', async () => {
    const term = veld.value.trim();
    const nr = ++teller;
    if (!term || !pagefind) { lijst.replaceChildren(); return; }
    const q = schoon(term);
    const woorden = q.split(' ');
    let data = await zoekPagina(q, nr);
    if (!data) return;
    // Woorden die op geen enkele gevonden pagina echt voorkomen, zijn onbekend (meestal een plaats zonder eigen pagina).
    const onbekend = woorden.filter((w) => w.length >= 3 && !data!.some((d) => bevat(d, w)));
    const bekend = woorden.filter((w) => !onbekend.includes(w));
    if (onbekend.length && bekend.length) data = await zoekPagina(bekend.join(' '), nr);
    else if (onbekend.length) data = [];
    if (!data) return;
    data = data.filter((d) => bekend.every((w) => w.length < 3 || bevat(d, w)));
    const items: HTMLLIElement[] = [];
    if (onbekend.length) {
      const plaats = onbekend.map((w) => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
      const li = Object.assign(document.createElement('li'), { className: 'onbekend' });
      li.innerHTML = `<p>${esc(melding.zin).replace('{p}', `<strong>${esc(plaats)}</strong>`)} ${esc(melding.verder)}</p><p class="verwijzingen"></p>${data.length ? `<p class="wel">${esc(melding.wel)}</p>` : ''}`;
      li.querySelector('.verwijzingen')!.append(...melding.links.map((l: any) => Object.assign(document.createElement('a'), { href: l.href, textContent: l.label })));
      items.push(li);
    }
    items.push(...sorteer(data, bekend.join(' ')).map(resultaat));
    if (!items.length) items.push(Object.assign(document.createElement('li'), { className: 'geen', textContent: paneel.dataset.geen }));
    lijst.replaceChildren(...items);
  });
  // Link naar de landenlijst onderaan dezelfde pagina: zoekpaneel dichtdoen.
  lijst.addEventListener('click', (e) => { if ((e.target as Element).closest('a[href^="#"]')) { paneel.hidden = true; knop.setAttribute('aria-expanded', 'false'); } });
</script>
<style>
  header { border-bottom: 1px solid var(--line); background: var(--white); position: relative; }
  .bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .75rem 2rem; padding-block: 1.15rem; }
  .logo { display: inline-flex; align-items: center; gap: .55rem; font-weight: 700; font-size: 1.3rem; color: var(--accent); text-decoration: none; letter-spacing: -.02em; }
  .logo-tekst span { font-weight: 400; }
  .logo-icoon { width: 1.9rem; height: 1.9rem; flex: none; }
  ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; align-items: center; gap: .25rem 1.25rem; }
  nav a { color: var(--text); text-decoration: none; font-weight: 500; font-size: .95rem; }
  nav a:hover, nav a[aria-current] { color: var(--accent); }
  .landen { color: var(--muted); font-weight: 400; }
  .landen-icoon { display: none; }
  .land-kort { display: none; }
  /* Mobiel: logo, land, andere landen (wereldbol) en zoeken op één regel. */
  @media (max-width: 640px) {
    .bar { flex-wrap: nowrap; gap: .75rem; padding-block: .8rem; }
    .logo { font-size: 1.1rem; gap: .4rem; flex: none; }
    .logo-icoon { width: 1.6rem; height: 1.6rem; }
    nav ul { flex-wrap: nowrap; gap: .6rem; }
    nav a { font-size: .9rem; white-space: nowrap; }
    .landen { display: grid; place-items: center; width: 2.25rem; height: 2.25rem; margin: -.3rem 0; color: var(--text); }
    .landen-icoon { display: block; }
    .landen-tekst { display: none; }
  }
  @media (max-width: 420px) {
    .land-lang { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    .land-kort { display: inline; }
  }
  .zoek-knop { display: grid; place-items: center; width: 2.25rem; height: 2.25rem; margin: -.3rem 0; padding: 0; border: 0; border-radius: 50%; background: none; color: var(--text); cursor: pointer; }
  .zoek-knop:hover, .zoek-knop[aria-expanded='true'] { color: var(--accent); background: var(--surface); }
  .zoek { border-top: 1px solid var(--line); background: var(--white); padding-block: .9rem 1rem; }
  .zoek-form { display: flex; align-items: center; gap: .6rem; max-width: 640px; padding: .15rem .4rem .15rem .9rem; border: 1.5px solid var(--line); border-radius: 10px; color: var(--muted); }
  .zoek-form:focus-within { border-color: var(--accent); }
  .zoek-form svg { flex: none; }
  .zoek input { flex: 1; min-width: 0; padding: .55rem 0; border: 0; outline: 0; background: none; font: inherit; font-size: 1rem; color: var(--text); }
  .zoek input::-webkit-search-cancel-button { display: none; }
  .zoek-sluit { display: grid; place-items: center; width: 2rem; height: 2rem; margin: 0; padding: 0; border: 0; border-radius: 50%; background: none; color: var(--muted); cursor: pointer; }
  .zoek-sluit:hover { color: var(--accent); background: var(--surface); }
  .zoek-resultaten { display: block; max-width: 640px; margin-top: .4rem; }
  .zoek-resultaten:empty { display: none; }
  .zoek-resultaten :global(li) { border-bottom: 1px solid var(--line); }
  .zoek-resultaten :global(li:last-child) { border-bottom: 0; }
  .zoek-resultaten :global(a) { display: block; padding: .6rem .25rem; color: var(--text); text-decoration: none; line-height: 1.45; }
  .zoek-resultaten :global(a:hover .titel), .zoek-resultaten :global(a:focus .titel) { color: var(--accent); }
  .zoek-resultaten :global(.titel) { font-weight: 600; }
  .zoek-resultaten :global(.land) { margin-left: .5rem; padding: .05rem .45rem; border-radius: 6px; background: var(--surface); color: var(--accent); font-size: .75rem; font-weight: 600; white-space: nowrap; }
  .zoek-resultaten :global(.uittreksel) { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; font-size: .88rem; color: var(--muted); }
  .zoek-resultaten :global(mark) { background: none; color: var(--text); font-weight: 600; }
  .zoek-resultaten :global(.onbekend) { padding: .7rem .25rem .5rem; font-size: .92rem; color: var(--muted); }
  .zoek-resultaten :global(.onbekend p) { margin: 0; }
  .zoek-resultaten :global(.onbekend strong) { color: var(--text); }
  .zoek-resultaten :global(.verwijzingen) { display: flex; flex-wrap: wrap; gap: .4rem; margin-top: .5rem !important; }
  .zoek-resultaten :global(.verwijzingen a) { display: inline-block; padding: .3rem .75rem; border: 1.5px solid var(--accent); border-radius: 999px; color: var(--accent); font-weight: 600; font-size: .88rem; line-height: 1.3; }
  .zoek-resultaten :global(.verwijzingen a:hover), .zoek-resultaten :global(.verwijzingen a:focus) { background: var(--accent); color: var(--white); }
  .zoek-resultaten :global(.wel) { margin-top: .8rem !important; font-weight: 600; color: var(--text); }
  .zoek-resultaten :global(.geen) { padding: .6rem .25rem; font-size: .92rem; color: var(--muted); }
</style>
