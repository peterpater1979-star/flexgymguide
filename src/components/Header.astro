---
import menu from '../data/menu.json';
const { land = 'global', lang = 'en' } = Astro.props;
// Geen landenlijst in de kop: bezoekers komen op hun eigen land binnen. "Andere landen" springt naar de landenlijst in de footer (de homepage zou de browser doorsturen naar het eigen land).
const landenLabel = { nl: 'Andere landen', de: 'Andere Länder', en: 'Other countries', fr: 'Autres pays', es: 'Otros países', pt: 'Outros países', da: 'Andre lande', sv: 'Andra länder', nb: 'Andre land', fi: 'Muut maat' }[lang as 'nl' | 'de' | 'en' | 'fr' | 'es' | 'pt' | 'da' | 'sv' | 'nb' | 'fi'];
const huidig = menu.main.find((m) => m.land === land);
const pad = Astro.url.pathname;
// De stedenbalk alleen op stadspagina's; op de landpagina staat de inhoud eerst.
const toonSteden = huidig && huidig.children.length > 0 && pad !== huidig.href;
// Op mobiel: de eerste 3 steden in de rij, de rest onder een uitklapknop.
const stadItems = toonSteden ? huidig.children.filter((c) => c.href !== huidig.href) : [];
const RIJ = 3;
const extra = stadItems.length > RIJ + 1 ? stadItems.slice(RIJ) : [];
const meerLabel = { nl: 'Meer', de: 'Mehr', en: 'More', fr: 'Plus', es: 'Más', pt: 'Mais', da: 'Flere', sv: 'Fler', nb: 'Flere', fi: 'Lisää' }[lang as 'nl' | 'de' | 'en' | 'fr' | 'es' | 'pt' | 'da' | 'sv' | 'nb' | 'fi'];
---
<header>
  <div class="wrap bar">
    <a class="logo" href="/"><svg class="logo-icoon" xmlns="http://www.w3.org/2000/svg" viewBox="2 6 44 44" aria-hidden="true"><rect x="2" y="6" width="44" height="44" rx="11" fill="currentColor"/><g transform="rotate(-30 24 28)" fill="#fff"><rect x="9" y="21" width="4" height="14" rx="1.5"/><rect x="13.5" y="23" width="4" height="10" rx="1.5"/><rect x="17" y="26.5" width="14" height="3" rx="1.5"/><rect x="30.5" y="23" width="4" height="10" rx="1.5"/><rect x="35" y="21" width="4" height="14" rx="1.5"/></g></svg><span class="logo-tekst">Flex<span>Gym</span>Guide</span></a>
    <nav aria-label="Main">
      <ul>
        {huidig && <li><a href={huidig.href} aria-current="true">{huidig.label}</a></li>}
        <li><a class="landen" href="#landen">{landenLabel}</a></li>
      </ul>
    </nav>
  </div>
  {toonSteden && (
    <nav class="sub" aria-label={huidig.label}>
      <div class="wrap">
        <ul>
          <li class={extra.length ? 'land' : undefined}><a href={huidig.href} aria-current={pad === huidig.href ? 'page' : undefined}>{huidig.label}</a></li>
          {stadItems.map((c, i) => <li class={extra.length && i >= RIJ && pad !== c.href ? 'extra' : undefined}><a href={c.href} aria-current={pad === c.href ? 'page' : undefined}>{c.label}</a></li>)}
          {extra.length > 0 && (
            <li class="meer">
              <details>
                <summary>{meerLabel}</summary>
                <ul>
                  {extra.map((c) => <li><a href={c.href} aria-current={pad === c.href ? 'page' : undefined}>{c.label}</a></li>)}
                </ul>
              </details>
            </li>
          )}
        </ul>
      </div>
    </nav>
  )}
</header>
<style>
  header { border-bottom: 1px solid var(--line); background: var(--white); }
  .bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .75rem 2rem; padding-block: 1.15rem; }
  .logo { display: inline-flex; align-items: center; gap: .55rem; font-weight: 700; font-size: 1.3rem; color: var(--accent); text-decoration: none; letter-spacing: -.02em; }
  .logo-tekst span { font-weight: 400; }
  .logo-icoon { width: 1.9rem; height: 1.9rem; flex: none; }
  ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: .25rem 1.25rem; }
  nav a { color: var(--text); text-decoration: none; font-weight: 500; font-size: .95rem; }
  nav a:hover, nav a[aria-current] { color: var(--accent); }
  .landen { color: var(--muted); font-weight: 400; }
  .sub { background: var(--white); border-top: 1px solid var(--line); }
  .sub ul { padding-block: .55rem; }
  .sub a { font-weight: 500; font-size: .9rem; color: var(--muted); }
  .sub a[aria-current='page'] { color: var(--accent); font-weight: 600; }
  .meer { display: none; }
  @media (max-width: 40rem) {
    .sub ul { gap: .35rem 1rem; }
    .sub .extra, .sub .land { display: none; }
    .sub .meer { display: block; }
    .sub .wrap { position: relative; }
    .meer summary { cursor: pointer; list-style: none; font-weight: 600; font-size: .9rem; color: var(--accent); }
    .meer summary::-webkit-details-marker { display: none; }
    .meer summary::after { content: ' ▾'; }
    .meer details[open] summary::after { content: ' ▴'; }
    .meer details ul { position: absolute; left: 1rem; right: 1rem; top: calc(100% - .1rem); columns: 2; column-gap: 0; z-index: 20; display: block; max-height: 60vh; overflow-y: auto; padding: .4rem 0; background: var(--white); border: 1px solid var(--line); border-radius: 10px; box-shadow: 0 8px 24px rgba(0,0,0,.12); }
    .meer details li a { display: block; padding: .55rem 1rem; }
  }
</style>
