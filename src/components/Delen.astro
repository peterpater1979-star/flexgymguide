---
// Deelknoppen zonder scripts of cookies (vervangt Shariff Wrapper).
const { title, lang = 'en' } = Astro.props;
const url = encodeURIComponent(new URL(Astro.url.pathname, Astro.site).href);
const t = encodeURIComponent(title);
const label = { nl: 'Delen', de: 'Teilen', en: 'Share' }[lang as 'nl' | 'de' | 'en'];
---
<p class="delen">
  <span>{label}:</span>
  <a href={`https://wa.me/?text=${t}%20${url}`} target="_blank" rel="noopener">WhatsApp</a>
  <a href={`https://www.facebook.com/sharer/sharer.php?u=${url}`} target="_blank" rel="noopener">Facebook</a>
  <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${url}`} target="_blank" rel="noopener">LinkedIn</a>
  <a href={`mailto:?subject=${t}&body=${url}`}>E-mail</a>
</p>
<style>
  .delen { display: flex; flex-wrap: wrap; gap: .5rem 1rem; font-size: .9rem; margin-top: 1rem; padding-top: 1rem; border-top: 1px solid var(--line); color: var(--muted); }
</style>
