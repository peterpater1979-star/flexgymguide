---
import { render, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Advertentiemelding from './Advertentiemelding.astro';
import Kruimelpad from './Kruimelpad.astro';
import Delen from './Delen.astro';
import TipFormulier from './TipFormulier.astro';
import Keuzehulp from './Keuzehulp.astro';
import { hreflang, ogLocale, gewijzigd, organisatie, hreflangGroep } from '../data/seo';

const { page } = Astro.props as { page: CollectionEntry<'pages'> };
const { Content } = await render(page);
const d = page.data;
const stad = /^\/(nl|de|uk)\/[^/]+\/$/.test(d.path);
const tip = !d.noindex && !d.path.startsWith('/contact/');
const affiliate = /\]\(\/go\/|href="\/go\//.test(page.body ?? '');
// Zoekfunctie (Pagefind): alleen geïndexeerde pagina's. De titel telt zwaar mee; land en taal bepalen de volgorde van de resultaten.
const zoek = !d.noindex;
const zoekAttr = zoek ? { 'data-pagefind-body': '' } : {};
// Zelfde pagina in een andere taal of ander land (hreflang): zie src/data/vertalingen.ts.
const groep = d.noindex ? [] : await hreflangGroep(d.path);
const alternates = groep.length > 1
  ? [...groep.map((x) => ({ hreflang: hreflang(x.lang, x.land), href: x.path })), ...(groep.some((x) => x.path === '/') ? [{ hreflang: 'x-default', href: '/' }] : [])]
  : [];
// Structured data: website en organisatie op de homepage, artikel met datum op gidsen en aanbiederpagina's.
const url = new URL(d.path, 'https://flexgymguide.com').href;
const datum = gewijzigd(page.filePath);
const jsonld: object[] = d.noindex ? [] : d.path === '/'
  ? [{ '@context': 'https://schema.org', ...organisatie }, { '@context': 'https://schema.org', '@type': 'WebSite', name: 'FlexGymGuide', url, inLanguage: 'en', publisher: { '@id': organisatie['@id'] } }]
  : d.byline
    ? [{ '@context': 'https://schema.org', '@type': 'Article', headline: d.title, description: d.description, inLanguage: d.lang, url, mainEntityOfPage: url, ...(datum && { dateModified: datum }), author: { '@type': 'Person', name: 'Peter Pater', url: 'https://flexgymguide.com/about/' }, publisher: organisatie, image: 'https://flexgymguide.com/og-image.png' }]
    : [];
// Keuzehulp in de kop: landenhomepage en (geïndexeerde) stadspagina's van ES, FR en DE.
const khLand = ['es', 'fr', 'de'].includes(d.land) && d.lang === d.land ? (d.land as 'es' | 'fr' | 'de') : null;
const khStad = khLand && /^(Guía de ciudad|Guide ville|Stadtguide)/.test(d.kicker ?? '') && /^\/[a-z]{2}\/[^/]+\/$/.test(d.path) && !/(sin-permanencia|sans-engagement|ohne-vertrag)/.test(d.path) && !d.noindex ? d.path.split('/')[2] : null;
const keuzehulp = khLand && (d.path === `/${khLand}/` || khStad);
const fmt = (date: Date) => new Intl.DateTimeFormat(d.lang === 'en' ? 'en-GB' : d.lang, { dateStyle: 'long' }).format(date);
---
<Base title={d.title} seoTitle={d.seoTitle} description={d.description} lang={d.lang} land={d.land} noindex={d.noindex} alternates={alternates} jsonld={jsonld} locale={ogLocale(d.lang, d.land)}>
  <div class="kop">
    <div class="wrap">
      {affiliate && <Advertentiemelding lang={d.lang} />}
      {d.path !== '/' && <Kruimelpad path={d.path} lang={d.lang} />}
      <h1>{d.title}</h1>
      {d.byline && <p class="klein meta">{d.byline}</p>}
      {!d.byline && d.updated && <p class="klein meta">{fmt(d.updated)}</p>}
      {keuzehulp && <Keuzehulp land={khLand} stad={khStad ?? ''} />}
    </div>
  </div>
  <article class="wrap prose" {...zoekAttr}>
    {zoek && <span hidden data-pagefind-weight="10" data-pagefind-meta="title">{d.title}</span>}
    {zoek && <span hidden data-pagefind-ignore data-pagefind-meta="land">{d.land}</span>}
    {zoek && <span hidden data-pagefind-ignore data-pagefind-meta="taal">{d.lang}</span>}
    {zoek && d.description && <span hidden data-pagefind-ignore data-pagefind-meta="beschrijving">{d.description}</span>}
    {/* Extra zoektermen als attribuut, niet als (verborgen) tekst: Pagefind leest het attribuut, Google ziet geen verborgen trefwoorden. */}
    {zoek && d.zoekwoorden && <span data-pagefind-weight="10" data-pagefind-index-attrs="data-zoekwoorden" data-zoekwoorden={d.zoekwoorden}></span>}
    <Content />
    <div data-pagefind-ignore="all">
      {tip && <TipFormulier lang={d.lang} pagina={d.path} stad={stad} />}
      {!d.noindex && d.land !== 'global' && <Delen title={d.title} lang={d.lang} />}
    </div>
  </article>
</Base>
