---
// Keuzehulp "Sportpas of sportschool?" in drie vragen (stad, hoe vaak, wat telt het zwaarst).
// Staat in de paginakop van de landenhomepages en stadspagina's van ES, FR en DE, zodat er op de telefoon zonder scrollen een duidelijke knop in beeld is.
// Neutraal (afspraak Peter 13-11): het advies noemt een SOORT (sportpas, sportschool of allebei), nooit één merk als winnaar.
// Links gaan alleen naar onze eigen overzichten (stadspagina met alle aanbieders, sportscholen zonder contract), geen externe of /go/-links, geen prijzen.
import { getCollection } from 'astro:content';

type Land = 'es' | 'fr' | 'de';
const { land, stad = '' } = Astro.props as { land: Land; stad?: string };

const kicker = { es: /^Guía de ciudad/, fr: /^Guide ville/, de: /^Stadtguide/ }[land];
const zonderContract = { es: 'gimnasio-sin-permanencia', fr: 'salle-de-sport-sans-engagement', de: 'fitnessstudio-ohne-vertrag' }[land];
const pages = await getCollection('pages', (p) => !p.data.draft && p.data.land === land);
const paden = new Set(pages.map((p) => p.data.path));
const steden = pages
  .filter((p) => kicker.test(p.data.kicker ?? '') && !p.data.noindex && !p.data.path.includes(zonderContract) && /^\/[a-z]{2}\/[^/]+\/$/.test(p.data.path))
  .map((p) => {
    const slug = p.data.path.split('/')[2];
    const zc = `/${land}/${zonderContract}-${slug}/`;
    return { slug, naam: p.data.crumb ?? slug, pagina: p.data.path, zonderContract: paden.has(zc) ? zc : null };
  })
  .sort((a, b) => a.naam.localeCompare(b.naam, land));

const t = {
  es: {
    open: '¿Pase deportivo o gimnasio?', openKlein: 'Descúbrelo en 3 preguntas',
    v1: '¿Dónde entrenas?', kies: 'Elige tu ciudad', ander: 'Otra ciudad',
    v2: '¿Cuántas veces por semana?', f: ['Una vez o menos', '2 o 3 veces', '4 o más'],
    v3: '¿Qué es lo más importante?', p: ['Pagar poco', 'Variedad de clases', 'Un sitio fijo'],
    advies: 'Lo que podría encajarte', opnieuw: 'Empezar de nuevo', vergelijk: 'Comparación completa: pase o gimnasio',
    noot: 'Una orientación según tus respuestas, no una recomendación de una marca concreta. Compara siempre precios y condiciones.',
    pas: 'Un pase deportivo', gym: 'Un gimnasio', mix: 'Las dos opciones',
    rPas: 'Con un pase deportivo reservas clases en distintos estudios y gimnasios, sin atarte a un solo sitio. Suele encajar si entrenas de vez en cuando o te gusta variar.',
    rGym: 'Si entrenas a menudo o prefieres ir siempre al mismo sitio, un gimnasio cerca de casa o del trabajo puede encajarte mejor.',
    rMix: 'Según tus respuestas, tanto un pase deportivo como un gimnasio pueden encajarte. Compara lo que hay en tu ciudad.',
    pasStad: 'Pases y gimnasios en {s}', pasLand: 'Todas las opciones en España', alles: 'Todas las opciones en {s}', gymStad: 'Gimnasios en {s}', gymLand: 'Gimnasios en España', zcStad: 'Sin permanencia en {s}', zcLand: 'Gimnasios sin permanencia',
  },
  fr: {
    open: 'Pass sport ou salle de sport ?', openKlein: 'Réponds à 3 questions',
    v1: 'Où fais-tu du sport ?', kies: 'Choisis ta ville', ander: 'Une autre ville',
    v2: 'Combien de fois par semaine ?', f: ['Une fois ou moins', '2 ou 3 fois', '4 fois ou plus'],
    v3: 'Qu’est-ce qui compte le plus ?', p: ['Payer peu', 'Varier les cours', 'Un endroit fixe'],
    advies: 'Ce qui pourrait te convenir', opnieuw: 'Recommencer', vergelijk: 'Comparaison complète : pass ou abonnement',
    noot: 'Une orientation selon tes réponses, pas la recommandation d’une marque. Compare toujours les prix et les conditions.',
    pas: 'Un pass sport', gym: 'Une salle de sport', mix: 'Les deux options',
    rPas: 'Avec un pass sport, tu réserves des cours dans différents studios et salles, sans être lié à un seul endroit. Souvent adapté si tu t’entraînes de temps en temps ou si tu aimes varier.',
    rGym: 'Si tu t’entraînes souvent ou préfères toujours le même endroit, une salle près de chez toi ou du travail peut mieux te convenir.',
    rMix: 'D’après tes réponses, un pass sport comme une salle peuvent te convenir. Compare ce qui existe dans ta ville.',
    pasStad: 'Pass et salles à {s}', pasLand: 'Toutes les options en France', alles: 'Toutes les options à {s}', gymStad: 'Salles de sport à {s}', gymLand: 'Salles de sport en France', zcStad: 'Sans engagement à {s}', zcLand: 'Salles sans engagement',
  },
  de: {
    open: 'Sportpass oder Fitnessstudio?', openKlein: 'Finde es mit 3 Fragen heraus',
    v1: 'Wo trainierst du?', kies: 'Wähle deine Stadt', ander: 'Andere Stadt',
    v2: 'Wie oft pro Woche?', f: ['Einmal oder seltener', '2- bis 3-mal', '4-mal oder öfter'],
    v3: 'Was ist dir am wichtigsten?', p: ['Wenig zahlen', 'Abwechslung', 'Ein fester Ort'],
    advies: 'Das könnte zu dir passen', opnieuw: 'Neu starten', vergelijk: 'Ausführlicher Vergleich: Sportpass oder Mitgliedschaft',
    noot: 'Eine Orientierung nach deinen Antworten, keine Empfehlung für eine bestimmte Marke. Vergleiche Preise und Bedingungen immer selbst.',
    pas: 'Ein Sportpass', gym: 'Ein Fitnessstudio', mix: 'Beides ist möglich',
    rPas: 'Mit einem Sportpass buchst du Kurse in verschiedenen Studios und Fitnessstudios, ohne dich an einen Ort zu binden. Passt oft, wenn du ab und zu trainierst oder gern abwechselst.',
    rGym: 'Trainierst du oft oder lieber immer am selben Ort, passt ein Fitnessstudio in der Nähe von Zuhause oder Arbeit vielleicht besser.',
    rMix: 'Nach deinen Antworten können ein Sportpass und ein Fitnessstudio passen. Vergleiche, was es in deiner Stadt gibt.',
    pasStad: 'Sportpässe und Studios in {s}', pasLand: 'Alle Möglichkeiten in Deutschland', alles: 'Alle Möglichkeiten in {s}', gymStad: 'Fitnessstudios in {s}', gymLand: 'Fitnessstudios in Deutschland', zcStad: 'Ohne Vertrag in {s}', zcLand: 'Fitnessstudios ohne Vertrag',
  },
}[land];

// Anker van het overzicht met alle aanbieders: op de stadspagina en op de landenhomepage.
const overzichtStad = { es: '#resumen', fr: '#en-bref', de: '#blick' }[land];
const overzichtLand = { es: '/es/#opciones', fr: '/fr/#options', de: '/de/#opties' }[land];
const vergelijkHref = { es: '/es/pase-o-gimnasio/', fr: '/fr/pass-sport-ou-abonnement/', de: '/de/sportpass-oder-mitgliedschaft/' }[land];
const data = { steden, t, vergelijk: vergelijkHref, zonderContractLand: `/${land}/${zonderContract}/`, overzichtStad, overzichtLand };
const id = 'keuzehulp';
---
<details class="keuzehulp" data-keuzehulp={JSON.stringify(data)}>
  <summary><span class="kh-titel">{t.open}</span> <span class="kh-sub">{t.openKlein} <span aria-hidden="true">→</span></span></summary>
  <form class="kh-vragen" onsubmit="return false">
    <label class="kh-vraag" for={`${id}-stad`}>1. {t.v1}</label>
    <select id={`${id}-stad`} name="stad">
      <option value="" disabled selected={!stad}>{t.kies}</option>
      {steden.map((s) => <option value={s.slug} selected={s.slug === stad}>{s.naam}</option>)}
      <option value="ander">{t.ander}</option>
    </select>
    <fieldset>
      <legend class="kh-vraag">2. {t.v2}</legend>
      <div class="kh-keuzes">{t.f.map((x, i) => <label><input type="radio" name="vaak" value={i} /><span>{x}</span></label>)}</div>
    </fieldset>
    <fieldset>
      <legend class="kh-vraag">3. {t.v3}</legend>
      <div class="kh-keuzes">{t.p.map((x, i) => <label><input type="radio" name="prio" value={i} /><span>{x}</span></label>)}</div>
    </fieldset>
    <div class="kh-advies" aria-live="polite" hidden></div>
  </form>
</details>

<script>
  type Stad = { slug: string; naam: string; pagina: string; zonderContract: string | null };
  document.querySelectorAll<HTMLDetailsElement>('details[data-keuzehulp]').forEach((el) => {
    const d = JSON.parse(el.dataset.keuzehulp!);
    const t = d.t;
    const form = el.querySelector('form')!;
    const uit = el.querySelector<HTMLDivElement>('.kh-advies')!;
    const bereken = () => {
      const f = new FormData(form);
      const slug = f.get('stad') as string | null;
      const vaak = f.get('vaak');
      const prio = f.get('prio');
      if (!slug || vaak === null || prio === null) { uit.hidden = true; return; }
      const s: Stad | undefined = d.steden.find((x: Stad) => x.slug === slug);
      const vul = (x: string) => x.replace('{s}', s?.naam ?? '');
      // Alleen een soort, geen merk: sportpas, sportschool of allebei.
      // Alle knoppen gaan naar het overzicht met alle aanbieders (stad of land); sportscholen zonder contract alleen als extra knop.
      const overzicht = s ? s.pagina + d.overzichtStad : d.overzichtLand;
      const zc = s ? (s.zonderContract ? { href: s.zonderContract, label: vul(t.zcStad) } : null) : { href: d.zonderContractLand, label: t.zcLand };
      const v = Number(vaak), p = Number(prio);
      // p: 0 = wenig betalen, 1 = afwisseling, 2 = vaste plek. v: 0 = 1x of minder, 1 = 2-3x, 2 = 4x of vaker.
      const soort = p === 1 ? (v === 2 ? 'mix' : 'pas')
        : p === 2 ? (v === 0 ? 'mix' : 'gym')
        : (v === 0 ? 'pas' : v === 1 ? 'mix' : 'gym');
      const naam = { pas: t.pas, gym: t.gym, mix: t.mix }[soort];
      const reden = { pas: t.rPas, gym: t.rGym, mix: t.rMix }[soort];
      const hoofdLabel = soort === 'pas' ? (s ? vul(t.pasStad) : t.pasLand) : soort === 'gym' ? (s ? vul(t.gymStad) : t.gymLand) : (s ? vul(t.alles) : t.pasLand);
      const doelen = [{ href: overzicht, label: hoofdLabel }, ...(soort !== 'pas' && zc ? [zc] : [])];
      // Met DOM-elementen opbouwen (geen HTML-tekst), zodat er niets uit de antwoorden als HTML wordt gelezen.
      const el = (tag: string, cls = '', tekst = '') => { const e = document.createElement(tag); if (cls) e.className = cls; if (tekst) e.textContent = tekst; return e; };
      const link = (cls: string, href: string, tekst: string) => { const a = el('a', cls, tekst) as HTMLAnchorElement; a.setAttribute('href', href); return a; };
      const knoppen = el('div', 'knoppen');
      knoppen.append(...doelen.map((x, i) => link(i === 0 ? 'knop' : 'knop knop-rand', x.href, x.label)));
      const opnieuw = el('button', 'kh-opnieuw', t.opnieuw) as HTMLButtonElement;
      opnieuw.type = 'button';
      opnieuw.addEventListener('click', () => { form.querySelectorAll<HTMLInputElement>('input[type=radio]').forEach((r) => (r.checked = false)); uit.hidden = true; });
      const verder = el('p', 'klein');
      verder.append(link('', d.vergelijk, t.vergelijk), ' · ', opnieuw);
      uit.replaceChildren(el('p', 'kh-label', t.advies), el('p', 'kh-naam', naam), el('p', '', reden), knoppen, verder, el('p', 'klein kh-noot', t.noot));
      uit.hidden = false;
    };
    form.addEventListener('change', bereken);
    bereken();
  });
</script>

<style is:global>
  /* Globaal (onder .keuzehulp), omdat het advies met JavaScript wordt ingevoegd. */
  .keuzehulp { margin: .9rem 0 .25rem; background: var(--white); border-radius: 12px; box-shadow: var(--shadow); max-width: 40rem; }
  .keuzehulp summary { list-style: none; cursor: pointer; padding: .8rem 1rem; display: flex; flex-wrap: wrap; align-items: baseline; column-gap: .6rem; row-gap: .1rem; border-radius: 12px; background: var(--cta); color: var(--text); }
  .keuzehulp summary::-webkit-details-marker { display: none; }
  .keuzehulp summary:hover { background: var(--cta-hover); }
  .keuzehulp[open] summary { border-radius: 12px 12px 0 0; }
  .keuzehulp .kh-titel { font-weight: 700; font-size: 1.02rem; }
  .keuzehulp .kh-sub { font-size: .9rem; font-weight: 500; }
  .keuzehulp .kh-vragen { padding: .25rem 1rem 1rem; }
  .keuzehulp .kh-vragen fieldset { border: 0; padding: 0; margin: 0; }
  .keuzehulp .kh-vraag { display: block; font-weight: 600; font-size: .95rem; margin: .9rem 0 .4rem; padding: 0; }
  .keuzehulp .kh-vragen select { width: 100%; max-width: 22rem; font: inherit; font-size: 1rem; padding: .55rem .7rem; border: 1px solid var(--line); border-radius: 8px; background: var(--white); color: var(--text); min-height: 44px; }
  .keuzehulp .kh-keuzes { display: flex; flex-wrap: wrap; gap: .5rem; }
  .keuzehulp .kh-keuzes label { margin: 0; font-weight: 500; }
  .keuzehulp .kh-keuzes input { position: absolute; opacity: 0; pointer-events: none; }
  .keuzehulp .kh-keuzes span { display: inline-flex; align-items: center; min-height: 44px; padding: .45rem .9rem; border: 1.5px solid var(--line); border-radius: 999px; font-size: .95rem; cursor: pointer; background: var(--white); }
  .keuzehulp .kh-keuzes input:checked + span { border-color: var(--accent); background: var(--surface); color: var(--accent); font-weight: 600; }
  .keuzehulp .kh-keuzes input:focus-visible + span { outline: 2px solid var(--accent); outline-offset: 2px; }
  .keuzehulp .kh-advies { margin-top: 1.1rem; padding: 1rem 1.1rem; border-radius: 10px; background: var(--surface); border-left: 4px solid var(--accent); }
  .keuzehulp .kh-advies p { margin: 0 0 .5rem; line-height: 1.5; }
  .keuzehulp .kh-label { font-size: .75rem; text-transform: uppercase; letter-spacing: .1em; font-weight: 600; color: var(--muted); }
  .keuzehulp .kh-naam { font-size: 1.25rem; font-weight: 700; }
  .keuzehulp .kh-advies .knoppen { margin: .75rem 0; }
  .keuzehulp .kh-opnieuw { background: none; border: 0; padding: 0; font: inherit; color: var(--accent); text-decoration: underline; cursor: pointer; }
  .keuzehulp .kh-noot { margin-bottom: 0 !important; font-size: .78rem; }
  .keuzehulp .kh-keuzes label { display: inline-block; margin: 0; }
</style>
